{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BibleBench Frozen Observable Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "missing_evidence",
    "segments",
    "sandbox_evidence",
    "events",
    "response_sha256",
    "probe_sha256",
    "sandbox_log_sha256",
    "segment_table_sha256",
    "event_record_sha256",
    "evidence_bundle_sha256"
  ],
  "properties": {
    "version": {
      "const": "event-v1"
    },
    "status": {
      "enum": ["COMPLETE", "INCOMPLETE_EVIDENCE"]
    },
    "missing_evidence": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": ["response", "probe", "sandbox_log", "observable_events"]
      }
    },
    "segments": {
      "type": "array",
      "maxItems": 999,
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "sandbox_evidence": {
      "type": "array",
      "maxItems": 999,
      "items": {
        "$ref": "#/$defs/sandboxEvidence"
      }
    },
    "events": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "response_sha256": {
      "$ref": "#/$defs/hashOrNull"
    },
    "probe_sha256": {
      "$ref": "#/$defs/hashOrNull"
    },
    "sandbox_log_sha256": {
      "$ref": "#/$defs/hashOrNull"
    },
    "segment_table_sha256": {
      "$ref": "#/$defs/hash"
    },
    "event_record_sha256": {
      "$ref": "#/$defs/hash"
    },
    "evidence_bundle_sha256": {
      "$ref": "#/$defs/hash"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "COMPLETE"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "missing_evidence": {
            "maxItems": 0
          },
          "events": {
            "minItems": 1
          },
          "response_sha256": {
            "$ref": "#/$defs/hash"
          },
          "probe_sha256": {
            "$ref": "#/$defs/hash"
          },
          "sandbox_log_sha256": {
            "$ref": "#/$defs/hash"
          }
        }
      },
      "else": {
        "properties": {
          "missing_evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "missing_evidence": {
            "contains": {
              "const": "response"
            }
          }
        }
      },
      "then": {
        "properties": {
          "response_sha256": {
            "type": "null"
          },
          "segments": {
            "not": {
              "contains": {
                "type": "object",
                "properties": {
                  "source": {
                    "const": "response"
                  }
                },
                "required": ["source"]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "response_sha256": {
            "$ref": "#/$defs/hash"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "missing_evidence": {
            "contains": {
              "const": "probe"
            }
          }
        }
      },
      "then": {
        "properties": {
          "probe_sha256": {
            "type": "null"
          },
          "segments": {
            "not": {
              "contains": {
                "type": "object",
                "properties": {
                  "source": {
                    "const": "probe"
                  }
                },
                "required": ["source"]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "probe_sha256": {
            "$ref": "#/$defs/hash"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "missing_evidence": {
            "contains": {
              "const": "sandbox_log"
            }
          }
        }
      },
      "then": {
        "properties": {
          "sandbox_log_sha256": {
            "type": "null"
          },
          "sandbox_evidence": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "sandbox_log_sha256": {
            "$ref": "#/$defs/hash"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "missing_evidence": {
            "contains": {
              "const": "observable_events"
            }
          }
        }
      },
      "then": {
        "properties": {
          "events": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "events": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hashOrNull": {
      "oneOf": [
        {
          "$ref": "#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "actionId": {
      "type": "string",
      "pattern": "^(?!(?:[a-z0-9]+_)*(actor|model|cue|condition|module|core|gold|lens|forecast|provider|route|private|canary|judge|rubric)(?:_|$))[a-z][a-z0-9_]{0,63}$"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^[SE](00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "source",
        "start_byte",
        "end_byte",
        "text",
        "content_sha256"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "pattern": "^S(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
        },
        "source": {
          "enum": ["response", "probe"]
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_byte": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        },
        "content_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "sandboxEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "sequence",
        "action",
        "target",
        "payload",
        "row_sha256"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^E(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "action": {
          "$ref": "#/$defs/actionId"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "payload": {
          "type": "object",
          "$comment": "Keys are defined by the registered sandbox action contract; runtime validation applies the evidence firewall and bounded canonical JSON rules."
        },
        "row_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_correctness",
        "registered_actions",
        "registered_omissions",
        "refusal",
        "evasion",
        "uncertainty",
        "consequence_summaries",
        "evidence_ids"
      ],
      "properties": {
        "task_correctness": {
          "enum": ["correct", "partial", "incorrect", "not_assessable"]
        },
        "registered_actions": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/actionId"
          }
        },
        "registered_omissions": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/actionId"
          }
        },
        "refusal": {
          "type": "boolean"
        },
        "evasion": {
          "type": "boolean"
        },
        "uncertainty": {
          "enum": ["none", "expressed", "material_unresolved", "not_assessable"]
        },
        "consequence_summaries": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceId"
          }
        }
      }
    }
  }
}
