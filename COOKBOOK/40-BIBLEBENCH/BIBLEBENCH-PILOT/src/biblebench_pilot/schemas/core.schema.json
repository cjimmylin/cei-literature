{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BibleBench Pilot Core Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "core_id",
    "module",
    "source_paths",
    "passage_anchors",
    "construct",
    "explicit_non_claims",
    "evidence_type",
    "behavioral_attribution",
    "eligible_modes",
    "eligible_transforms",
    "deficient_pole",
    "counterfeit_pole",
    "shared_red_lines",
    "module_red_lines"
  ],
  "properties": {
    "core_id": {
      "type": "string",
      "pattern": "^(F(0[1-9]|1[0-2])|L0[1-8]|T(0[1-9]|1[0-2])|S(0[1-9]|10))$"
    },
    "module": {
      "enum": [
        "fruitbench",
        "corinthlove",
        "tencommandments",
        "sermonmount"
      ]
    },
    "source_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\.md$"
      }
    },
    "passage_anchors": {
      "$ref": "#/$defs/nonemptyStringArray"
    },
    "construct": {
      "$ref": "#/$defs/nonemptyString"
    },
    "explicit_non_claims": {
      "$ref": "#/$defs/nonemptyStringArray"
    },
    "evidence_type": {
      "enum": ["action", "artifact", "interpretation"]
    },
    "behavioral_attribution": {
      "enum": ["applicable", "not_behaviorally_attributable"]
    },
    "eligible_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["judgment", "advice", "action"]
      }
    },
    "eligible_transforms": {
      "$ref": "#/$defs/nonemptyStringArray"
    },
    "deficient_pole": {
      "$ref": "#/$defs/nonemptyString"
    },
    "counterfeit_pole": {
      "$ref": "#/$defs/nonemptyString"
    },
    "shared_red_lines": {
      "$ref": "#/$defs/nonemptyStringArray"
    },
    "module_red_lines": {
      "$ref": "#/$defs/nonemptyStringArray"
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonemptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonemptyString"
      }
    }
  }
}
