# Local configuration (contains user-specific paths)
.vault-config.json

# Log files
logs/*.json
logs/*.log

# Python cache
__pycache__/
*.pyc
*.pyo

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak

# AI Labs PDFs (stub files - actual PDFs are in external AI-Lab-PDFs directory)
AI Labs/**/*.pdf

# RECYCLE-BIN directory (deleted/archived files - should not be synced)
RECYCLE-BIN/

# BACKGROUND original PDFs (large binary files - text extracts are tracked instead)
CULTURAL-GLOBAL/BACKGROUND/ORIG/
CULTURAL-GLOBAL/BACKGROUND/Documents/

# --- 2026-07-10 cleanup session additions ---
# Session/tool caches
.pytest_cache/
**/.pytest_cache/
.playwright-mcp/
**/.playwright-mcp/
.DS_Store
**/.DS_Store
__pycache__/
*.pyc
*.pyo

# Policy: PDFs live outside the repo (Lit-WS-PDFs/) or in BACKGROUND ORIG dirs; extracts are tracked instead.
# (Pre-existing tracked PDFs are unaffected — gitignore does not apply to tracked files.)
*.pdf

