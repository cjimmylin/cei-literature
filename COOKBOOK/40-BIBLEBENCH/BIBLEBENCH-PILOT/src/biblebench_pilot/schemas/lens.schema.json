{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BibleBench Module-Native Lens Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lens_id",
    "module_owner",
    "pillar",
    "normative_profile",
    "construct",
    "applicable_core_ids",
    "applicable_episode_roles",
    "required_event_fields",
    "native_scorer_adapter",
    "rubric_version",
    "behavioral_attribution_states",
    "forbidden_metadata",
    "rules"
  ],
  "properties": {
    "lens_id": {
      "type": "string",
      "pattern": "^(fruitbench|corinthlove|tencommandments|sermonmount)\\.[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "module_owner": {
      "$ref": "#/$defs/module"
    },
    "pillar": {
      "enum": ["ethical_reliability", "biblical_pastoral_fidelity"]
    },
    "normative_profile": {
      "enum": ["observable_ethics", "broad_evangelical_protestant"]
    },
    "construct": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "applicable_core_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 42,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/coreId"
      }
    },
    "applicable_episode_roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["target", "null", "restraint"]
      }
    },
    "required_event_fields": {
      "$ref": "#/$defs/eventFields"
    },
    "native_scorer_adapter": {
      "type": "string",
      "pattern": "^(fruitbench|corinthlove|tencommandments|sermonmount)\\.native\\.[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "rubric_version": {
      "type": "string",
      "pattern": "^rv-[0-9][a-z0-9._-]{0,63}$"
    },
    "behavioral_attribution_states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": ["applicable", "not_behaviorally_attributable"]
      }
    },
    "forbidden_metadata": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "module": {
      "enum": [
        "fruitbench",
        "corinthlove",
        "tencommandments",
        "sermonmount"
      ]
    },
    "coreId": {
      "type": "string",
      "pattern": "^(F(0[1-9]|1[0-2])|L0[1-8]|T(0[1-9]|1[0-2])|S(0[1-9]|10))$"
    },
    "eventField": {
      "enum": [
        "task_correctness",
        "registered_actions",
        "registered_omissions",
        "refusal",
        "evasion",
        "uncertainty",
        "consequence_summaries",
        "evidence_ids"
      ]
    },
    "eventFields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/eventField"
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "criterion",
        "required_event_fields",
        "assessment_target",
        "doctrinal_status",
        "contestability"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^R(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
        },
        "criterion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "required_event_fields": {
          "$ref": "#/$defs/eventFields"
        },
        "assessment_target": {
          "enum": [
            "observable_behavior",
            "passage_interpretation",
            "pastoral_counsel",
            "role_boundary"
          ]
        },
        "doctrinal_status": {
          "enum": [
            "not_theological",
            "scripture_primary",
            "broad_evangelical_protestant_core",
            "declared_protestant_contested"
          ]
        },
        "contestability": {
          "enum": ["clear", "contested"]
        }
      }
    }
  }
}
