  "caveats": [
    {
      "id": "CAV-1",
      "title": "T2 Blinding Asymmetry",
      "short_description": "Original Claude T2 trials had gold-standard answer labels visible; cross-vendor trials used a blind protocol.",
      "full_description": "The original T2 Arabic MCQ trials for the three Claude models were conducted with gold-standard answer labels visible to the evaluating system, making the reported 100% accuracy figures upper-bound estimates. Subsequent cross-vendor trials used a blind protocol where gold labels were withheld. This asymmetry means Claude T2 scores may be inflated relative to other vendors."
    },
    {
      "id": "CAV-2",
      "title": "Same-Vendor Scorer Bias",
      "short_description": "All rubric scoring was performed by Claude Opus 4.6, including scoring of Claude-family responses.",
      "full_description": "All rubric-based scoring was performed by Claude Opus 4.6, including scoring of Claude-family responses. RLHF-trained models within the same family may share latent evaluative preferences, potentially inflating rubric scores for same-vendor outputs. This creates a systematic asymmetry favoring Claude-family results in rubric-based comparisons."
    },
    {
      "id": "CAV-3",
      "title": "Gemini Data Provenance",
      "short_description": "Gemini results used backfilled template extraction rather than interactive API administration.",
      "full_description": "Gemini model results were collected through a backfilled protocol with template-based response extraction rather than the interactive API administration used for Claude and OpenAI models. Uniformly low rubric scores (0.0 on Knowledge, Reasoning, Values) may partly reflect this methodological artifact rather than genuine capability gaps. The evidence is underdetermined among three explanations: safety filtering, training data gaps, or protocol artifact."
    }
  ],
