{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sermonmount.local/shared/judges/schemas/family-registry-v1.schema.json",
  "type": "object",
  "required": ["registry_version", "families", "aliases"],
  "properties": {
    "registry_version": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"},
    "families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["family_id"],
        "properties": {"family_id": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"}},
        "additionalProperties": false
      }
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["alias", "family_id"],
        "properties": {
          "alias": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"},
          "family_id": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
