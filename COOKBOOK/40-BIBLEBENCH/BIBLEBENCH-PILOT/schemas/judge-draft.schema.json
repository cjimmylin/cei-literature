{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BibleBench Pass-One Judge Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "draft_version",
    "status",
    "source_packet_sha256",
    "records"
  ],
  "properties": {
    "draft_version": {"const": "biblebench-pass-one-judge-draft-v1"},
    "status": {"enum": ["DRAFT_INCOMPLETE", "DRAFT_COMPLETE"]},
    "source_packet_sha256": {"$ref": "#/$defs/hash"},
    "records": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/draftRecord"}
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "episodeId": {
      "type": "string",
      "pattern": "^[FLTS](?:0[1-9]|1[0-2])-(?:TARGET|NULL|RESTRAINT)-0[1-9]$"
    },
    "trackDecision": {
      "enum": [null, "APPROVE", "REVISE", "REJECT", "DEFER", "NOT_APPLICABLE"]
    },
    "recordDecision": {
      "enum": [null, "APPROVE", "REVISE", "REJECT", "DEFER"]
    },
    "boundedText": {
      "type": "string",
      "minLength": 8,
      "maxLength": 8000
    },
    "boundedTextOrNull": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "maxLength": 8000}
      ]
    },
    "ownerIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "priority",
        "track",
        "summary",
        "affected_fields",
        "repair_condition"
      ],
      "properties": {
        "issue_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"
        },
        "priority": {"enum": [null, "P0", "P1", "P2", "P3"]},
        "track": {"enum": [null, "behavior", "interpretive", "record", "custody"]},
        "summary": {
          "type": "string",
          "maxLength": 8000
        },
        "affected_fields": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        },
        "repair_condition": {
          "type": "string",
          "maxLength": 8000
        }
      }
    },
    "completedOwnerIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "priority",
        "track",
        "summary",
        "affected_fields",
        "repair_condition"
      ],
      "properties": {
        "issue_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"
        },
        "priority": {"enum": ["P0", "P1", "P2", "P3"]},
        "track": {"enum": ["behavior", "interpretive", "record", "custody"]},
        "summary": {"$ref": "#/$defs/boundedText"},
        "affected_fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 512
          }
        },
        "repair_condition": {"$ref": "#/$defs/boundedText"}
      }
    },
    "draftRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "status",
        "owner_behavior_decision",
        "owner_interpretive_decision",
        "owner_record_decision",
        "owner_behavior_rationale",
        "owner_interpretive_rationale",
        "owner_confidence",
        "owner_contestability",
        "owner_issues",
        "owner_issues_editor",
        "owner_judge_id",
        "owner_notes",
        "owner_reviewed_at"
      ],
      "properties": {
        "episode_id": {"$ref": "#/$defs/episodeId"},
        "status": {"enum": ["DRAFT_INCOMPLETE", "DRAFT_COMPLETE"]},
        "owner_behavior_decision": {"$ref": "#/$defs/trackDecision"},
        "owner_interpretive_decision": {"$ref": "#/$defs/trackDecision"},
        "owner_record_decision": {"$ref": "#/$defs/recordDecision"},
        "owner_behavior_rationale": {"$ref": "#/$defs/boundedTextOrNull"},
        "owner_interpretive_rationale": {"$ref": "#/$defs/boundedTextOrNull"},
        "owner_confidence": {"enum": [null, "low", "medium", "high"]},
        "owner_contestability": {
          "enum": [null, "clear", "contested", "outside_competence"]
        },
        "owner_issues": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/ownerIssue"}
            }
          ]
        },
        "owner_issues_editor": {
          "type": "string",
          "maxLength": 262144
        },
        "owner_judge_id": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "maxLength": 64}
          ]
        },
        "owner_notes": {"$ref": "#/$defs/boundedTextOrNull"},
        "owner_reviewed_at": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "format": "date-time",
              "maxLength": 20
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "DRAFT_COMPLETE"}}},
          "then": {
            "properties": {
              "owner_behavior_decision": {"type": "string"},
              "owner_interpretive_decision": {"type": "string"},
              "owner_record_decision": {"type": "string"},
              "owner_behavior_rationale": {"$ref": "#/$defs/boundedText"},
              "owner_interpretive_rationale": {"$ref": "#/$defs/boundedText"},
              "owner_confidence": {"type": "string"},
              "owner_contestability": {"type": "string"},
              "owner_issues": {
                "type": "array",
                "items": {"$ref": "#/$defs/completedOwnerIssue"}
              },
              "owner_judge_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{2,63}$"
              },
              "owner_notes": {
                "oneOf": [
                  {"type": "null"},
                  {"$ref": "#/$defs/boundedText"}
                ]
              },
              "owner_reviewed_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              }
            }
          }
        }
      ]
    }
  }
}
